# Application Settings
APP_NAME="OpenStudyBuilder API"
UVICORN_ROOT_PATH="/"
APP_DEBUG=false
COLOR_LOGS=true
UID=1000
NUMBER_OF_UID_DIGITS=6

# Database Settings
NEO4J_DATABASE="neo4j"
NEO4J_DSN="bolt://neo4j:test1234@localhost:7687/neo4j"
NEO4J_CONNECTION_LIFETIME=1740
NEO4J_LIVENESS_CHECK_TIMEOUT=300

# Cache Settings
CACHE_MAX_SIZE=1000
CACHE_TTL=3600

# Security & CORS
ALLOW_ORIGIN_REGEX="^https?://(osb\.)?(localhost|127\.0\.0\.1)(:[0-9]+)?$"
ALLOW_CREDENTIALS=true
ALLOW_METHODS="*"
ALLOW_HEADERS="*"

# OAuth & Authentication
OAUTH_ENABLED=true
OAUTH_RBAC_ENABLED=true
OAUTH_METADATA_URL="https://control.example.com/.well-known/openid-configuration"
OAUTH_API_APP_ID="accuratrial-openstudybuilder"
OAUTH_API_APP_ID_URI=""
OAUTH_API_APP_SECRET=""
OAUTH_SWAGGER_APP_ID=""
OAUTH_UI_APP_ID=""
OIDC_DELEGATED_CLAIMS_REQUIRED=false
OIDC_EXCHANGING_CLIENTS="accuratrial-command-center,accuratrial-control-worker"
OIDC_ALLOWED_PURPOSES="interactive-domain-access,workflow-orchestration"
OIDC_ALLOWED_CAPABILITIES="study:read,study:write,candidate:read,candidate:generate,candidate:apply,package:release,native-identity:bind,native-identity:inventory,platform-command:execute"
OIDC_ALLOWED_ROLES="Admin.Read,Admin.Write,Study.Read,Study.Write,Library.Read,Library.Write,service"
OIDC_MAX_ACCESS_TOKEN_TTL_SECONDS=300
OIDC_JWKS_CACHE_TTL_SECONDS=300
OIDC_REVOKED_KIDS=""

# Production authority policy. The current V1 export is non-authoritative in
# shadow mode and cannot be sent to EDC. Never enable unsafe legacy send in prod.
DEPLOYMENT_ENVIRONMENT=development
MAPPING_AUTHORITY_MODE=shadow
OSB_NATIVE_IDENTITY_ENDPOINT_ENABLED=false
OSB_NATIVE_IDENTITY_INVENTORY_ENABLED=true
OSB_PLATFORM_COMMANDS_PROTOTYPE_ENABLED=true
OSB_PLATFORM_COMMAND_SIGNING_URL=
# Enable only after the additive Neo4j constraints are installed and verified.
PLATFORM_DOMAIN_AUDIT_MODE=disabled
PLATFORM_REGION=local
ALLOW_UNSAFE_LEGACY_EDC_SEND=false

# EDC M2M integration (disabled while governed send is gated).
EDC_BASE_URL=""
EDC_API_KEY=""

# Pagination Settings
DEFAULT_PAGE_NUMBER=1
DEFAULT_PAGE_SIZE=10
DEFAULT_HEADER_PAGE_SIZE=10
DEFAULT_FILTER_OPERATOR="and"
MAX_PAGE_SIZE=1000
PAGE_SIZE_100=100

# Performance
SLOW_QUERY_DURATION=1

# Tracing & Monitoring
UVICORN_LOG_CONFIG="logging-azure.yaml"
TRACEBACK_MAX_ENTRIES=15
TRACING_ENABLED=true
TRACING_METRICS_HEADER=false
TRACE_REQUEST_BODY=false
TRACE_REQUEST_BODY_MIN_STATUS_CODE=400
TRACE_REQUEST_BODY_TRUNCATE_BYTES=2048
TRACE_QUERY_MAX_LEN=4000
APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=00000000-0000-0000-0000-000000000000"
# To enable tracing to Zipkin, setting of ZIPKIN_HOST is required
ZIPKIN_HOST=localhost
ZIPKIN_PORT=9411
ZIPKIN_ENDPOINT=/api/v2/spans
ZIPKIN_PROTOCOL=http

# Testing & Schemathesis
SCHEMATHESIS_STUDY_UID=Study_000006
SCHEMATHESIS_HOOKS="clinical_mdr_api.hooks.schemathesis_hooks"

# Third-party Integrations
MS_GRAPH_INTEGRATION_ENABLED=true
MS_GRAPH_GROUPS_QUERY="\$filter=startsWith(displayName, 'OpenStudyBuilder')"

# gzip API responses (Content-Encoding: gzip)
GZIP_RESPONSE_MIN_SIZE=1000
GZIP_LEVEL=5
