{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.accuratrials.invalid/osb/osb-candidate-request-v1.schema.json",
  "title": "OsbCandidateRequestV1",
  "description": "OSB-owned receiving contract produced by CSL from one immutable SemanticSnapshotV1 and SourceFactPackageV1. CSL does not select a native target.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "requestId",
    "requestVersionId",
    "tenantId",
    "platformStudyId",
    "osbStudyIdentity",
    "sourceFactPackage",
    "semanticSnapshot",
    "activeClaimRevisions",
    "requestedObjectFamilies",
    "typedSourceIntents",
    "evidenceArtifactRefs",
    "projectionRuleset",
    "inputConservation",
    "checkpointPreconditions",
    "expiresAt",
    "createdAt",
    "createdBy"
  ],
  "properties": {
    "contractVersion": { "enum": ["OsbCandidateRequestV1@1.0.0", "OsbCandidateRequestV1@1.1.0", "OsbCandidateRequestV1@1.2.0", "OsbCandidateRequestV1@1.3.0"] },
    "requestId": { "type": "string", "format": "uuid" },
    "requestVersionId": { "type": "string", "format": "uuid" },
    "tenantId": { "type": "string", "format": "uuid" },
    "platformStudyId": { "type": "string", "format": "uuid" },
    "osbStudyIdentity": { "$ref": "#/$defs/osbStudyIdentity" },
    "sourceFactPackage": { "$ref": "#/$defs/sourcePackageRef" },
    "semanticSnapshot": { "$ref": "#/$defs/snapshotRef" },
    "activeClaimRevisions": {
      "type": "array",
      "maxItems": 1000000,
      "items": { "$ref": "#/$defs/activeClaimRevision" }
    },
    "requestedObjectFamilies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/resourceFamily" }
    },
    "typedSourceIntents": {
      "type": "array",
      "maxItems": 1000000,
      "items": { "$ref": "#/$defs/typedSourceIntent" }
    },
    "evidenceArtifactRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/artifactRef" }
    },
    "projectionRuleset": { "$ref": "#/$defs/projectionRuleset" },
    "inputConservation": { "$ref": "#/$defs/requestCensus" },
    "checkpointPreconditions": { "$ref": "#/$defs/checkpoint" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "type": "string", "minLength": 1, "maxLength": 1024 }
  },
  "allOf": [{
    "if": { "properties": { "contractVersion": { "enum": ["OsbCandidateRequestV1@1.0.0", "OsbCandidateRequestV1@1.1.0"] } } },
    "then": { "properties": { "typedSourceIntents": { "type": "array", "items": {
      "type": "object", "properties": { "resourceFamily": { "not": { "const": "study_metadata" } }, "nativeStudyOperation": false }
    } } } }
  }, {
    "if": { "properties": { "contractVersion": { "enum": ["OsbCandidateRequestV1@1.0.0", "OsbCandidateRequestV1@1.1.0", "OsbCandidateRequestV1@1.2.0"] } } },
    "then": { "properties": { "typedSourceIntents": { "type": "array", "items": {
      "type": "object", "properties": { "source": { "type": "object", "properties": { "context": false } } }
    } } } }
  }],
  "$defs": {
    "legacyOsbStudyIdentity": {
      "title": "OsbLegacyStudyIdentityV1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "system",
        "tenantId",
        "platformStudyId",
        "namespace",
        "objectType",
        "bindingId",
        "nativeIdentity",
        "nativeVersion",
        "verificationStatus"
      ],
      "properties": {
        "contractVersion": {
          "const": "1.0.0"
        },
        "system": {
          "const": "osb"
        },
        "tenantId": {
          "type": "string",
          "format": "uuid"
        },
        "platformStudyId": {
          "type": "string",
          "format": "uuid"
        },
        "namespace": {
          "const": "accuratrials-osb"
        },
        "objectType": {
          "const": "study-draft-root"
        },
        "bindingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "nativeIdentity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "nativeVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "verificationStatus": {
          "const": "verified"
        }
      }
    },
    "externalOsbStudyIdentity": {
      "title": "OsbExternalStudyIdentityV1",
      "description": "The complete verified external identity, including its original receipt evidence; copied without replacing the platform binding ID.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "bindingId",
        "tenantId",
        "platformStudyId",
        "system",
        "namespace",
        "objectType",
        "nativeIdentity",
        "verificationStatus",
        "verifiedBy",
        "verifiedAt",
        "validFrom",
        "evidence",
        "createdAt",
        "createdBy",
        "nativeVersion"
      ],
      "properties": {
        "contractVersion": {
          "enum": [
            "1.0.0",
            "1.1.0"
          ]
        },
        "bindingId": {
          "type": "string",
          "format": "uuid"
        },
        "tenantId": {
          "type": "string",
          "format": "uuid"
        },
        "platformStudyId": {
          "type": "string",
          "format": "uuid"
        },
        "system": {
          "const": "osb"
        },
        "namespace": {
          "const": "accuratrials-osb"
        },
        "objectType": {
          "const": "study-draft-root"
        },
        "nativeIdentity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "nativeVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "verificationStatus": {
          "const": "verified"
        },
        "verifiedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "validFrom": {
          "type": "string",
          "format": "date-time"
        },
        "validTo": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "receiptId",
            "receiptPayloadHash"
          ],
          "dependentRequired": {
            "signedEnvelopeHash": [
              "trustBundleVersion",
              "trustBundleHash",
              "trustedSigningTime"
            ],
            "trustBundleVersion": [
              "signedEnvelopeHash",
              "trustBundleHash",
              "trustedSigningTime"
            ],
            "trustBundleHash": [
              "signedEnvelopeHash",
              "trustBundleVersion",
              "trustedSigningTime"
            ],
            "trustedSigningTime": [
              "signedEnvelopeHash",
              "trustBundleVersion",
              "trustBundleHash"
            ]
          },
          "properties": {
            "receiptId": {
              "type": "string",
              "format": "uuid"
            },
            "receiptPayloadHash": {
              "$ref": "#/$defs/externalIdentityHashRef"
            },
            "signedEnvelopeHash": {
              "$ref": "#/$defs/externalIdentityHashRef"
            },
            "trustBundleVersion": {
              "type": "integer",
              "minimum": 1
            },
            "trustBundleHash": {
              "$ref": "#/$defs/externalIdentityHashRef"
            },
            "trustedSigningTime": {
              "type": "string",
              "format": "date-time"
            },
            "evidenceRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "uniqueItems": true,
              "maxItems": 64
            }
          },
          "title": "OsbExternalIdentityEvidenceV1"
        },
        "supersedesBindingId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "contractVersion": {
                "const": "1.0.0"
              }
            },
            "required": [
              "contractVersion"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "type": "object",
                "properties": {
                  "signedEnvelopeHash": false,
                  "trustBundleVersion": false,
                  "trustBundleHash": false,
                  "trustedSigningTime": false
                }
              }
            }
          }
        }
      ]
    },
    "externalIdentityHashRef": {
      "title": "OsbExternalIdentityHashRefV1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalizationVersion",
        "value",
        "mediaType",
        "schemaVersion",
        "excludedPaths"
      ],
      "properties": {
        "algorithm": {
          "const": "sha-256"
        },
        "canonicalizationVersion": {
          "const": "canonical-json/1.0"
        },
        "value": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "mediaType": {
          "const": "application/json"
        },
        "schemaVersion": {
          "type": "string",
          "minLength": 1
        },
        "excludedPaths": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "hashRef": {
      "title": "OsbCandidateHashRefV1",
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalizationVersion", "value", "mediaType", "schemaVersion", "excludedPaths"],
      "properties": {
        "algorithm": { "const": "sha-256" },
        "canonicalizationVersion": { "enum": ["canonical-json/1.0", "raw-bytes/1.0"] },
        "value": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 256 },
        "schemaVersion": { "type": "string", "minLength": 1, "maxLength": 256 },
        "excludedPaths": { "type": "array", "maxItems": 0, "items": { "type": "string" } }
      }
    },
    "resourceFamily": {
      "title": "OsbResourceFamilyV1",
      "enum": [
        "activities",
        "activity_instruction_templates",
        "activity_schedules",
        "assignments",
        "branching",
        "cdash_variables",
        "compound_product_relationships",
        "conditions",
        "controlled_terminology",
        "controlled_terminology_codelists",
        "criteria_templates",
        "edit_checks",
        "endpoint_templates",
        "objective_templates",
        "odm_aliases",
        "odm_conditions",
        "odm_forms",
        "odm_item_groups",
        "odm_items",
        "odm_methods",
        "study_compound_dosing_relationships",
        "study_metadata",
        "timeframe_templates",
        "timeframes",
        "units"
      ]
    },
    "osbStudyIdentity": {
      "title": "OsbStudyIdentityV1",
      "description": "Preserve the historical thin 1.0 identity and complete verified ExternalStudyIdentityV1 1.0/1.1 values. Full identities retain every receipt and trust field.",
      "oneOf": [
        {
          "$ref": "#/$defs/legacyOsbStudyIdentity"
        },
        {
          "$ref": "#/$defs/externalOsbStudyIdentity"
        }
      ]
    },
    "sourcePackageRef": {
      "title": "OsbCandidateSourcePackageRefV1",
      "type": "object",
      "additionalProperties": false,
      "required": ["packageVersionId", "payloadHash", "factSetHash"],
      "properties": {
        "packageVersionId": { "type": "string", "format": "uuid" },
        "payloadHash": { "$ref": "#/$defs/hashRef" },
        "factSetHash": { "$ref": "#/$defs/hashRef" }
      }
    },
    "snapshotRef": {
      "title": "OsbCandidateSnapshotRefV1",
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotVersionId", "payloadHash", "memberSetHash"],
      "properties": {
        "snapshotVersionId": { "type": "string", "format": "uuid" },
        "payloadHash": { "$ref": "#/$defs/hashRef" },
        "memberSetHash": { "$ref": "#/$defs/hashRef" }
      }
    },
    "activeClaimRevision": {
      "title": "OsbCandidateActiveClaimRevisionV1",
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceFactId", "revision", "lifecycle", "valueHash"],
      "properties": {
        "sourceFactId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "revision": { "type": "integer", "minimum": 1 },
        "lifecycle": { "type": "string", "minLength": 1, "maxLength": 64 },
        "valueHash": { "$ref": "#/$defs/hashRef" }
      }
    },
    "typedValue": {
      "title": "OsbTypedSourceValueV1",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sourcePath", "valueType", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sourcePath": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "valueType": { "type": "string", "minLength": 1, "maxLength": 64 },
        "value": true
      }
    },
    "typedSourceIntent": {
      "title": "OsbTypedSourceIntentV1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factId", "revision", "conceptId", "targetKey", "semanticRole",
        "resourceFamily", "source", "evidence", "searchStrings", "searchCodes", "createOption"
      ],
      "allOf": [{
        "if": { "properties": { "resourceFamily": { "const": "study_metadata" } } },
        "then": {
          "required": ["nativeStudyOperation"],
          "properties": { "nativeStudyOperation": { "$ref": "#/$defs/studyMetadataPlan" } }
        },
        "else": { "properties": { "nativeStudyOperation": false } }
      }],
      "properties": {
        "factId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "revision": { "type": "integer", "minimum": 1 },
        "conceptId": { "type": "string", "format": "uuid" },
        "targetKey": { "const": "primary" },
        "semanticRole": { "type": "string", "minLength": 1, "maxLength": 256 },
        "resourceFamily": { "$ref": "#/$defs/resourceFamily" },
        "nativeStudyOperation": { "$ref": "#/$defs/studyMetadataPlan" },
        "source": {
          "title": "OsbTypedSourceIntentSourceV1",
          "type": "object",
          "additionalProperties": false,
          "required": ["assertionType", "clinicalDomain", "candidateType", "exactQuote", "label", "values"],
          "properties": {
            "assertionType": { "type": ["string", "null"] },
            "clinicalDomain": { "type": ["string", "null"] },
            "candidateType": { "type": ["string", "null"] },
            "exactQuote": { "type": ["string", "null"] },
            "label": { "type": ["string", "null"] },
            "classification": {
              "description": "1.1.0: the claim's classification object carried VERBATIM (already inside the hash-pinned fact). Deliberately open — its shape is the IL fact's, not this contract's.",
              "type": ["object", "null"]
            },
            "context": {
              "title": "OsbTypedSourceContextV1",
              "description": "1.3.0: exact source collection and relationship context. These retained sections are not native execution fields or approval. Absence, explicit null and empty arrays remain distinct.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "encounters": {
                  "description": "FactDto.encounters, including occurrence-specific form scope, conditions, timing and evidence.",
                  "type": ["array", "null"],
                  "items": true
                },
                "relationships": {
                  "description": "FactDto.relationships with exact endpoints, evidence and source attribution.",
                  "type": ["array", "null"],
                  "items": true
                },
                "semanticAssociations": {
                  "description": "FactDto.downstream.semanticAssociations, including unresolved or ambiguous native object references.",
                  "type": ["array", "null"],
                  "items": true
                },
                "unresolvedRelationships": {
                  "description": "FactDto.extraction.unresolvedRelationships retained with their original evidence.",
                  "type": ["array", "null"],
                  "items": true
                }
              }
            },
            "values": {
              "type": "array",
              "maxItems": 1000,
              "items": { "$ref": "#/$defs/typedValue" }
            }
          }
        },
        "evidence": true,
        "searchStrings": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "searchCodes": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "searchStringsOmitted": {
          "description": "1.1.0: entries the 20-item/256-char caps dropped — truncation is receipted, never silent.",
          "type": "integer",
          "minimum": 0
        },
        "searchCodesOmitted": {
          "description": "1.1.0: entries the 20-item/128-char caps dropped.",
          "type": "integer",
          "minimum": 0
        },
        "createOption": {
          "title": "OsbCreateOptionV1",
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "requestedNativeType"],
          "properties": {
            "allowed": { "const": true },
            "requestedNativeType": {
              "description": "1.1.0: null when the claim states no candidate type — the manufactured 'governed-extension' default is gone.",
              "type": ["string", "null"],
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    },
    "studyMetadataPlan": {
      "title": "OsbStudyMetadataPlanV1",
      "description": "Source-pinned CSL metadata proposal. OSB resolves references and supplies a native precondition before a signed decision can apply it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "assertionType", "ruled", "osbResourceType", "osbCapability", "kind", "route", "method", "metadataPath", "metadataValue"],
      "properties": {
        "contractVersion": { "const": "OsbStudyMetadataPlanV1@1.0.0" },
        "assertionType": { "type": "string", "minLength": 1 },
        "ruled": { "const": true },
        "osbResourceType": { "const": "StudyMetadata" },
        "osbCapability": { "type": "string", "minLength": 1 },
        "kind": { "const": "native-metadata" },
        "route": { "const": "/studies/{study_uid}" },
        "method": { "const": "PATCH" },
        "metadataPath": { "type": "string", "minLength": 1, "maxLength": 256 },
        "metadataValue": true,
        "metadataJoinedText": { "type": "boolean" },
        "metadataMultiValued": { "type": "boolean" },
        "termRefs": { "type": "object", "additionalProperties": { "$ref": "#/$defs/metadataTermRef" } },
        "unitRefs": { "type": "object", "additionalProperties": { "$ref": "#/$defs/metadataUnitRef" } },
        "dictionaryRefs": { "type": "object", "additionalProperties": { "$ref": "#/$defs/metadataDictionaryRef" } },
        "consumedFields": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "basis": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "metadataTermRef": {
      "title": "OsbMetadataTermRefV1",
      "type": "object", "additionalProperties": false,
      "required": ["termName", "codelistName", "basis"],
      "properties": {
        "termName": { "type": "string", "minLength": 1 },
        "codelistName": { "type": "string", "minLength": 1 },
        "basis": { "type": "string", "minLength": 1 }
      }
    },
    "metadataUnitRef": {
      "title": "OsbMetadataUnitRefV1",
      "type": "object", "additionalProperties": false,
      "required": ["unitName", "basis"],
      "properties": {
        "unitName": { "type": "string", "minLength": 1 },
        "basis": { "type": "string", "minLength": 1 }
      }
    },
    "metadataDictionaryRef": {
      "title": "OsbMetadataDictionaryRefV1",
      "type": "object", "additionalProperties": false,
      "required": ["termName", "libraryName", "dictionaryCodelistName", "basis"],
      "properties": {
        "termName": { "type": "string", "minLength": 1 },
        "libraryName": { "type": "string", "minLength": 1 },
        "dictionaryCodelistName": { "type": "string", "minLength": 1 },
        "basis": { "type": "string", "minLength": 1 }
      }
    },
    "artifactRef": {
      "title": "OsbCandidateEvidenceArtifactRefV1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion", "artifactId", "artifactVersionId", "kind", "stableLocator",
        "payloadHash", "descriptorHash", "byteSize", "classification", "tenantId", "region",
        "producerService", "producerEnvironment", "producerVersion", "payloadContract",
        "payloadContractVersion", "purpose", "createdAt"
      ],
      "properties": {
        "contractVersion": { "const": "ArtifactRefV1@1.0.0" },
        "artifactId": { "type": "string", "format": "uuid" },
        "artifactVersionId": { "type": "string", "format": "uuid" },
        "kind": { "type": "string", "minLength": 3, "maxLength": 128 },
        "stableLocator": { "type": "string", "minLength": 8, "maxLength": 2048 },
        "payloadHash": { "$ref": "#/$defs/hashRef" },
        "descriptorHash": { "$ref": "#/$defs/hashRef" },
        "byteSize": { "type": "integer", "minimum": 0 },
        "classification": { "type": "string", "minLength": 1, "maxLength": 64 },
        "tenantId": { "type": "string", "format": "uuid" },
        "region": { "type": "string", "minLength": 2, "maxLength": 64 },
        "producerService": { "type": "string", "minLength": 3, "maxLength": 128 },
        "producerEnvironment": { "type": "string", "minLength": 2, "maxLength": 64 },
        "producerVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "payloadContract": { "type": "string", "minLength": 3, "maxLength": 256 },
        "payloadContractVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
        "purpose": { "type": "string", "minLength": 3, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "projectionRuleset": {
      "title": "OsbProjectionRulesetV1",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash"],
      "properties": {
        "id": { "const": "csl-to-osb-candidate-request" },
        "version": { "const": "1.0.0" },
        "hash": { "$ref": "#/$defs/hashRef" }
      }
    },
    "requestCensus": {
      "title": "ConservationCensusV1",
      "description": "Value-level source-to-target conservation rows. Aggregate counts alone are not proof.",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "rows", "rowSetHash", "counts"],
      "properties": {
        "contractVersion": { "const": "ConservationCensusV1@1.0.0" },
        "rows": {
          "type": "array",
          "maxItems": 1000000,
          "items": { "$ref": "#/$defs/censusRow" }
        },
        "rowSetHash": { "$ref": "#/$defs/hashRef" },
        "counts": {
          "title": "ConservationCensusCountsV1",
          "type": "object",
          "additionalProperties": false,
          "required": ["rows", "native", "governedExtension", "excludedSigned", "deferredBlocking", "quarantined", "rejected"],
          "properties": {
            "rows": { "type": "integer", "minimum": 0 },
            "native": { "type": "integer", "minimum": 0 },
            "governedExtension": { "type": "integer", "minimum": 0 },
            "excludedSigned": { "type": "integer", "minimum": 0 },
            "deferredBlocking": { "type": "integer", "minimum": 0 },
            "quarantined": { "type": "integer", "minimum": 0 },
            "rejected": { "type": "integer", "minimum": 0 }
          }
        },
        "upstreamExclusions": {
          "title": "OsbCandidateUpstreamExclusionsV1",
          "description": "1.1.0: package-boundary exclusions referenced by hash — informational, NOT rows in this census. The counts stay row-derived; this block tells OSB that M facts were suppressed before the request was built.",
          "type": "object",
          "additionalProperties": false,
          "required": ["sourcePackageCensusHash", "excludedSigned", "quarantined"],
          "properties": {
            "sourcePackageCensusHash": {
              "type": ["string", "null"],
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "excludedSigned": { "type": "integer", "minimum": 0 },
            "quarantined": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "censusEndpoint": {
      "title": "ConservationEndpointV1",
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "contract", "type", "path", "valueHash"],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "contract": { "type": "string", "minLength": 1, "maxLength": 256 },
        "type": { "type": "string", "minLength": 1, "maxLength": 256 },
        "path": { "type": "string", "pattern": "^#(?:/(?:[^~/]|~[01])*)*$", "maxLength": 4096 },
        "valueHash": { "$ref": "#/$defs/hashRef" }
      }
    },
    "censusExclusionPolicy": {
      "title": "ConservationExclusionPolicyV1",
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "policyVersion", "approver", "reason", "sourcePath"],
      "properties": {
        "policyId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "policyVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "approver": { "type": "string", "minLength": 1, "maxLength": 3072 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "sourcePath": { "type": "string", "pattern": "^#(?:/(?:[^~/]|~[01])*)*$", "maxLength": 4096 }
      }
    },
    "censusRow": {
      "title": "ConservationCensusRowV1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unitId", "source", "target", "multiplicity", "splitMergeGroup", "splitMergeRule",
        "ordering", "disposition", "exclusionPolicy", "evidenceRefs", "receiptRefs"
      ],
      "properties": {
        "unitId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "source": { "$ref": "#/$defs/censusEndpoint" },
        "target": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/censusEndpoint" }] },
        "multiplicity": {
          "title": "ConservationCensusMultiplicityV1",
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "target"],
          "properties": {
            "source": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "target": { "type": "integer", "minimum": 0, "maximum": 1000000 }
          }
        },
        "splitMergeGroup": { "type": ["string", "null"], "maxLength": 512 },
        "splitMergeRule": { "type": ["string", "null"], "maxLength": 512 },
        "ordering": {
          "title": "ConservationCensusOrderingV1",
          "type": "object",
          "additionalProperties": false,
          "required": ["significant", "sourceIndex", "targetIndex"],
          "properties": {
            "significant": { "type": "boolean" },
            "sourceIndex": { "type": ["integer", "null"], "minimum": 0 },
            "targetIndex": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "disposition": {
          "enum": ["native", "governed_extension", "excluded_signed", "deferred_blocking", "quarantined", "rejected"]
        },
        "exclusionPolicy": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/censusExclusionPolicy" }] },
        "evidenceRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "receiptRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } }
      }
    },
    "checkpoint": {
      "title": "OsbCandidateCheckpointV1",
      "type": "object",
      "additionalProperties": false,
      "required": ["osbNativeVersion", "semanticSnapshotHash"],
      "properties": {
        "osbNativeVersion": { "type": ["string", "null"] },
        "semanticSnapshotHash": { "$ref": "#/$defs/hashRef" }
      }
    }
  }
}
