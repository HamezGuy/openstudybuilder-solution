    "ObservationHash": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha-256",
          "title": "Algorithm",
          "type": "string"
        },
        "canonicalizationVersion": {
          "const": "canonical-json/1.0",
          "title": "Canonicalizationversion",
          "type": "string"
        },
        "value": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        },
        "mediaType": {
          "maxLength": 128,
          "title": "Mediatype",
          "type": "string"
        },
        "schemaVersion": {
          "maxLength": 128,
          "title": "Schemaversion",
          "type": "string"
        },
        "excludedPaths": {
          "items": {
            "type": "string"
          },
          "maxItems": 0,
          "title": "Excludedpaths",
          "type": "array"
        }
      },
      "required": [
        "algorithm",
        "canonicalizationVersion",
        "value",
        "mediaType",
        "schemaVersion",
        "excludedPaths"
