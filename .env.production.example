# OpenStudyBuilder production configuration behind AccuraTrial Command Center.
# Copy to the deployment secret store/environment; never commit real values.

BUILD_TARGET=prod
DEPLOYMENT_ENVIRONMENT=production
BIND_ADDRESS=127.0.0.1

# Neo4j is private to the compose network. Replace the password and keep Bolt/
# HTTP/Neodash host ports blocked from public ingress.
NEO4J_PASSWORD=REPLACE_WITH_RANDOM_SECRET
OSB_NEO4J_DSN=bolt://neo4j:REPLACE_WITH_URL_ENCODED_PASSWORD@database:7687/mdrdb

# Command Center is the only interactive identity broker.
OSB_API_AUTH_ENABLED=True
OSB_API_RBAC_ENABLED=True
OSB_UI_OAUTH_ENABLED=false
COMMAND_CENTER_METADATA_URL=https://control.acuratrials.com/.well-known/openid-configuration
COMMAND_CENTER_OSB_AUDIENCE=accuratrial-openstudybuilder
ALLOW_ORIGIN_REGEX=^https://osb\.acuratrials\.com$

# Mapping authority must be explicit in production. Shadow/enforced modes refuse
# the legacy StudyBundleV1 EDC sender. Command Center ALLOW_EDC_SEND must remain
# false until the native governed release-package sender is implemented.
MAPPING_AUTHORITY_MODE=shadow
ALLOW_UNSAFE_LEGACY_EDC_SEND=false
OSB_NATIVE_IDENTITY_ENDPOINT_ENABLED=false
OSB_NATIVE_IDENTITY_INVENTORY_ENABLED=false
OSB_PLATFORM_COMMANDS_PROTOTYPE_ENABLED=false
PLATFORM_DOMAIN_AUDIT_MODE=enforced
PLATFORM_REGION=REPLACE_WITH_APPROVED_REGION

# Leave blank while EDC send is gated. When the governed sender exists, use an
# EDC x-api-key scoped only to forms:import-study-bundle. The estate host sets
# http://accuratrial-edc-core-api-1:3000; Command Center's release leg attaches
# the api container to the EDC network after every recreate.
EDC_BASE_URL=
EDC_API_KEY=

# The Intelligence Layer's api and worker join this compose network, so the
# service name "api" resolves to both APIs here. Address this API by container
# name: the frontend proxy (compose.production.yaml) and the extensions API.
OSB_FRONTEND_API_HOST=opensourcebuilder-api-1
API_BASE_URL=http://opensourcebuilder-api-1:5003/api

# Optional image pins. Use immutable digests/tags in the actual release.
DATABASE_IMAGE=
API_IMAGE=
FRONTEND_IMAGE=
DOCUMENTATION_IMAGE=
NEODASH_IMAGE=
