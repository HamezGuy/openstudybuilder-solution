{
  "name": "studybuilder",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode dev",
    "build:staging": "vite build --mode staging",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js --fix --ignore-path .gitignore",
    "lint:staged": "eslint --fix",
    "format": "prettier --write .",
    "format:staged": "prettier --write",
    "update-config": "cat public/config.json | scripts/update-config.awk | tee public/config.json",
    "i18n:report": "vue-cli-service i18n:report --src './src/**/*.?(js|vue)' --locales './src/locales/**/*.json'",
    "prepare": "husky",
    "build-sbom": "python3 assbom.py --yarn --append sbom-append.md --fallback-dir doc/licenses --level 2 --output sbom.md"
  },
  "dependencies": {
    "@formkit/drag-and-drop": "^0.5.3",
    "@microsoft/applicationinsights-clickanalytics-js": "^3.2.0",
    "@microsoft/applicationinsights-web": "^3.2.0",
    "@vueup/vue-quill": "^1.2.0",
    "axios": "^1.15.0",
    "brace-expansion": "^1.1.13",
    "buffer": "^6.0.3",
    "chart.js": "^4.4.0",
    "dompurify": "^3.3.2",
    "exceljs": "^4.4.0",
    "flatted": "^3.4.2",
    "html2canvas": "^1.4.1",
    "immutable": "^5.1.5",
    "luxon": "^3.4.4",
    "marked": "^10.0.0",
    "oidc-client-ts": "^3.0.0-beta.0",
    "picomatch": "^4.0.4",
    "pinia": "^2.1.7",
    "quill-table-better": "^1.2.3",
    "tslib": "^2.8.1",
    "unzipper": "^0.12.3",
    "vue": "^3.4.19",
    "vue-chartjs": "^5.2.0",
    "vue-i18n": "11.1.10",
    "vue-router": "^4.2.5",
    "vuetify": "4.0.2",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@mdi/font": "^7.3.67",
    "@vitejs/plugin-vue": "^5.0.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.20.1",
    "husky": "^9.1.7",
    "license-checker": "^25.0.1",
    "prettier": "^3.2.5",
    "sass": "^1.99.0",
    "sass-embedded": "^1.86.0",
    "vite": "^6.4.2",
    "vite-plugin-vuetify": "^2.1.3"
  },
  "resolutions": {
    "quill": "2.0.2",
    "exceljs/**/archiver": "^7.0.1",
    "exceljs/**/unzipper": "^0.12.3",
    "exceljs/**/tmp": "^0.2.7",
    "exceljs/**/uuid": "^11.1.1",
    "**/archiver-utils/glob": "^10.5.0",
    "exceljs/**/minimatch": "^9.0.7",
    "eslint/**/minimatch": "^3.1.4",
    "license-checker/**/minimatch": "^3.1.4",
    "**/immutable": "^5.1.5",
    "**/flatted": "^3.4.2",
    "eslint/**/brace-expansion": "^1.1.13",
    "license-checker/**/brace-expansion": "^1.1.13",
    "exceljs/**/brace-expansion": "^2.1.4",
    "**/postcss": "^8.5.26",
    "**/@nevware21/ts-utils": "^0.16.0",
    "**/form-data": "^4.0.6",
    "vue/**/nanoid": "^3.3.17",
    "**/picomatch": "^4.0.4",
    "**/lodash": "^4.18.1",
    "**/lodash-es": "^4.18.1"
  },
  "packageManager": "yarn@1.22.22"
}
