# Resolve service addresses again after containers are recreated. The official
# nginx entrypoint exports the container's configured DNS servers into this
# template; upstream zones retain ordinary prefix/URI proxy behaviour.
resolver $NGINX_LOCAL_RESOLVERS valid=5s;
resolver_timeout 5s;

upstream studybuilder_api {
    zone studybuilder_api 64k;
    server $API_HOST:$API_PORT resolve;
}
upstream studybuilder_consumer_api {
    zone studybuilder_consumer_api 64k;
    server $CONSUMER_API_HOST:$CONSUMER_API_PORT resolve;
}
upstream studybuilder_extensions_api {
    zone studybuilder_extensions_api 64k;
    server $EXTENSIONS_API_HOST:$EXTENSIONS_API_PORT resolve;
}
upstream studybuilder_docs {
    zone studybuilder_docs 64k;
    server $DOC_HOST:$DOC_PORT resolve;
}
upstream studybuilder_neodash {
    zone studybuilder_neodash 64k;
    server $NEODASH_HOST:$NEODASH_PORT resolve;
}

map $sent_http_content_type $expires {
    image/x-icon                   1y;
    application/pdf                1y;
    video/x-flv                    1y;
    application/javascript         14d;
    text/css                       14d;
    image/png                      14d;
    image/jpeg                     14d;
    image/gif                      14d;
    application/x-shockwave-flash  14d;
    text/html                       -1;
    text/xml                       14d;
    text/plain                     14d;
    default                        off;
}

server {
    # Protocol-scale mapping contexts and Proposal V2.1 are bounded at 128 MiB
    # by both producer and API validation. The proxy must accept that contract.
    client_max_body_size 128m;
    listen       $PORT;
    server_name  localhost;
    include      mime.types;

    # A missing static asset must 404 and never fall through to index.html.
    # Returning HTML for a .js request makes the browser execute HTML as a
    # module: it fails silently, leaves a blank page, and logs nothing anywhere.
    location ~* \.(js|mjs|css|map|png|jpe?g|gif|svg|ico|webp|avif|woff2?|ttf|eot|json|txt|xml)$ {
        root   /usr/share/nginx/html;
        expires $expires;
        try_files $uri =404;
    }

    location / {
        root   /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
        index  index.html index.htm;
        expires $expires;
    }

    location ^~ $API_PATH {
        proxy_pass http://studybuilder_api/;
        # The EDC export (/integrations/edc/.../study-bundle) walks every ODM
        # item and takes >60s on a full study; nginx's default 60s
        # proxy_read_timeout returned 504 while the API was still working.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location ^~ $CONSUMER_API_PATH {
        proxy_pass http://studybuilder_consumer_api/;
    }

    location ^~ $EXTENSIONS_API_PATH {
        proxy_pass http://studybuilder_extensions_api/;
    }

    location ^~ $DOC_PATH {
        proxy_pass http://studybuilder_docs/;
    }

    location ^~ $NEODASH_PATH {
        proxy_pass http://studybuilder_neodash/;
    }

    # redirect server error pages to the static page /50x.html
    #
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}
