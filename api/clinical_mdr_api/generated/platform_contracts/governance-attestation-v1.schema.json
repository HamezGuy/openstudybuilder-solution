{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.accuratrials.com/csl/GovernanceAttestationV1/1.1",
  "title": "GovernanceAttestationV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "attestationId",
    "attestationVersionId",
    "tenantId",
    "platformStudyId",
    "packageArtifact",
    "packageRawByteHash",
    "sourceFactPackage",
    "semanticSnapshotHash",
    "decisionSetHash",
    "transformationCheckpointHash",
    "specialistReviewLockReceipt",
    "preReleaseApproval",
    "platformManifest",
    "policyProfileVersions",
    "conservationHash",
    "verification",
    "signatureState",
    "productionEligible",
    "attestedAt",
    "attestedBy"
  ],
  "properties": {
    "contractVersion": {
      "enum": [
        "GovernanceAttestationV1@1.0.0",
        "GovernanceAttestationV1@1.1.0"
      ]
    },
    "attestationId": {
      "type": "string",
      "format": "uuid"
    },
    "attestationVersionId": {
      "type": "string",
      "format": "uuid"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "platformStudyId": {
      "type": "string",
      "format": "uuid"
    },
    "packageArtifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "packageRawByteHash": {
      "$ref": "#/$defs/HashRef"
    },
    "sourceFactPackage": {
      "type": "object"
    },
    "semanticSnapshotHash": {
      "$ref": "#/$defs/HashRef"
    },
    "decisionSetHash": {
      "$ref": "#/$defs/HashRef"
    },
    "transformationCheckpointHash": {
      "$ref": "#/$defs/HashRef"
    },
    "specialistReviewLockReceipt": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "preReleaseApproval": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "platformManifest": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "policyProfileVersions": {
      "type": "object"
    },
    "conservationHash": {
      "$ref": "#/$defs/HashRef"
    },
    "verification": {
      "type": "object"
    },
    "signatureState": {
      "const": "prototype-unsigned"
    },
    "productionEligible": {
      "const": false
    },
    "attestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "attestedBy": {
      "type": "string",
      "minLength": 1
    },
    "studyStandards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "semanticSnapshotId",
        "semanticSnapshotHash"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/StudyStandardsReferenceV1"
        },
        "semanticSnapshotId": {
          "type": "string",
          "format": "uuid"
        },
        "semanticSnapshotHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  },
  "$defs": {
    "HashRef": {
      "type": "object",
      "required": [
        "algorithm",
        "canonicalizationVersion",
        "value",
        "mediaType",
        "schemaVersion",
        "excludedPaths"
      ],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "ArtifactRef": {
      "type": "object",
      "required": [
        "contractVersion",
        "artifactId",
        "artifactVersionId",
        "kind",
        "payloadHash",
        "descriptorHash"
      ]
    },
    "StudyStandardsReferenceV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "nativeTenantId",
        "nativeStudyId",
        "artifactId",
        "artifactVersionId",
        "contentHash"
      ],
      "properties": {
        "contractVersion": {
          "const": "StudyStandardsReferenceV1@1.0.0"
        },
        "nativeTenantId": {
          "type": "string",
          "format": "uuid"
        },
        "nativeStudyId": {
          "type": "string",
          "format": "uuid"
        },
        "artifactId": {
          "type": "string",
          "format": "uuid"
        },
        "artifactVersionId": {
          "type": "string",
          "format": "uuid"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "contractVersion": {
            "const": "GovernanceAttestationV1@1.1.0"
          }
        }
      },
      "then": {
        "required": [
          "studyStandards"
        ],
        "properties": {
          "studyStandards": {},
          "verification": {
            "type": "object",
            "required": [
              "studyStandardsCustody",
              "studyStandardsSourceMembership"
            ],
            "properties": {
              "studyStandardsCustody": {
                "const": true
              },
              "studyStandardsSourceMembership": {
                "const": true
              }
            }
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "studyStandards"
          ],
          "properties": {
            "studyStandards": {}
          }
        }
      }
    }
  ]
}
